# --- Odoo (the middleware logs in as a dedicated low-privilege user created by create_ai_user.py) ---
ODOO_URL=http://127.0.0.1:8069
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=
# Only for seed_demo.py / create_ai_user.py
ODOO_ADMIN_USERNAME=
ODOO_ADMIN_PASSWORD=

# --- Middleware API ---
# "apikey:callername" pairs, comma separated
API_KEYS=
# Callers allowed to confirm (not just draft) sales orders
CONFIRM_CALLERS=
RATE_LIMIT_PER_MINUTE=60
TIMEZONE=Asia/Dhaka
WORK_START_HOUR=9
WORK_END_HOUR=18
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ids, comma separated (send /id to the bot to see yours)
TELEGRAM_ALLOWED_USER_IDS=
MIDDLEWARE_URL=http://127.0.0.1:8000
MIDDLEWARE_API_KEY=
# whisper-large-v3 handles Bengali and English; optional language hint (en, bn)
GROQ_TRANSCRIBE_MODEL=whisper-large-v3
GROQ_TRANSCRIBE_LANGUAGE=
