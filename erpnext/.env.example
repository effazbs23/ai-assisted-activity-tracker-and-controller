# ERPNext Activity Assistant - configuration template.
# Copy to .env (cp .env.example .env) and fill in the blanks. .env is git-ignored: never commit real keys.
# scripts/setup_erpnext.py fills ERP_USERS, API_KEYS, CONFIRM_CALLERS and MIDDLEWARE_KEYS for you.
# Variables already set in the shell win over this file.

# =====================================================================================================
# 1. ERPNext
# =====================================================================================================
# Base URL of ERPNext (v15), no trailing path.
ERP_URL=http://127.0.0.1:8000
# Seconds before a call to ERPNext fails.
ERP_TIMEOUT=20

# One ERPNext user per caller. Format: caller:api_key:api_secret, comma separated.
# Every action runs as that ERPNext user, so ERPNext roles and permissions apply.
# Generated by scripts/setup_erpnext.py (ERPNext: User > API Access > Generate Keys).
ERP_USERS=

# Administrator login. Used ONLY by scripts/setup_erpnext.py, seed_demo.py and reset_demo.py,
# never by the running service. Remove it from .env in production.
ERP_ADMIN_USERNAME=Administrator
ERP_ADMIN_PASSWORD=admin

# =====================================================================================================
# 2. Middleware API (FastAPI)
# =====================================================================================================
# Keys that clients (the Telegram bot, scripts) present in the X-API-Key header.
# Format: api_key:caller, comma separated. The caller name must exist in ERP_USERS.
# Generate a key:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEYS=

# Callers allowed to SUBMIT (finalize) Sales Orders. Everyone else can only create drafts.
CONFIRM_CALLERS=

# Requests per caller per minute (HTTP 429 beyond that).
RATE_LIMIT_PER_MINUTE=60
# Upper bound for any "limit" query parameter.
MAX_PAGE_SIZE=50
# Seconds a proposed action can still be confirmed with "yes".
ACTION_TTL_SECONDS=900
# Idle seconds before a conversation's context is forgotten, and how many recent messages are kept.
SESSION_TTL_SECONDS=3600
SESSION_MAX_MESSAGES=12
# Timezone for "today", "tomorrow", "last month" in what users say or type.
TIMEZONE=Asia/Muscat

# =====================================================================================================
# 3. Language model: Claude OR any OpenAI-compatible endpoint
# =====================================================================================================
# anthropic -> Claude through the Anthropic API
# openai    -> OpenAI, Groq, Azure OpenAI, OpenRouter, Ollama... anything serving /chat/completions with tools
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Claude:  claude-sonnet-5-5 (suggested), claude-haiku-5-5 (lowest cost), claude-opus-5-5 (most capable)
# OpenAI:  e.g. gpt-5.4-mini.   Groq: e.g. openai/gpt-oss-120b
LLM_MODEL=claude-sonnet-5-5

# OpenAI-compatible only. Empty = https://api.openai.com/v1
#   Groq:   https://api.groq.com/openai/v1      Ollama: http://localhost:11434/v1
LLM_BASE_URL=
# OpenAI-compatible only. Comma separated models tried in order if the main one fails.
LLM_FALLBACK_MODELS=
# OpenAI-compatible only. Leave EMPTY for models that accept only their default temperature.
# (Never sent to Claude: current Claude models reject non-default values.)
LLM_TEMPERATURE=0
# Claude only: low | medium | high. Controls thinking depth and therefore cost. Empty = provider default.
LLM_EFFORT=medium

# =====================================================================================================
# 4. Telegram bot (telegram_bot.py)
# =====================================================================================================
# Token from @BotFather. Run only ONE bot process per token.
TELEGRAM_BOT_TOKEN=
# Who may use the bot and as which caller. Format: telegram_user_id:caller, comma separated.
# Find your id: message the bot /id (works for anyone), then add it here and restart the bot.
TELEGRAM_USERS=
# Where the bot reaches the middleware, and the API key it uses for each caller.
# MIDDLEWARE_KEYS format: caller:api_key (written by scripts/setup_erpnext.py, same keys as API_KEYS).
MIDDLEWARE_URL=http://127.0.0.1:8100
MIDDLEWARE_KEYS=

# =====================================================================================================
# 5. Voice notes: speech-to-text (any OpenAI-compatible /audio/transcriptions endpoint)
# =====================================================================================================
# Leave STT_API_KEY empty to disable voice (text still works).
STT_API_KEY=
#   Groq:   https://api.groq.com/openai/v1  with STT_MODEL=whisper-large-v3
#   OpenAI: https://api.openai.com/v1       with STT_MODEL=whisper-1 or gpt-4o-mini-transcribe
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3
# Optional ISO-639-1 hint (en, ar) to stop auto-detection guessing the wrong language.
STT_LANGUAGE=
