# --- ERPNext ---
ERP_URL=http://127.0.0.1:8000
ERP_TIMEOUT=20
# Each caller acts in ERPNext as ITS OWN user, so ERPNext roles and permissions apply.
# "caller:api_key:api_secret" triples, comma separated (generated by scripts/setup_erpnext.py)
ERP_USERS=
# Only for scripts/setup_erpnext.py and scripts/seed_demo.py
ERP_ADMIN_USERNAME=Administrator
ERP_ADMIN_PASSWORD=admin

# --- Middleware API ---
# "apikey:callername" pairs, comma separated; callername must match an ERP_USERS caller
API_KEYS=
# Callers allowed to submit (finalize) Sales Orders
CONFIRM_CALLERS=
RATE_LIMIT_PER_MINUTE=60
TIMEZONE=Asia/Muscat
ACTION_TTL_SECONDS=900

# --- Language model: any OpenAI-compatible endpoint OR Claude ---
# LLM_PROVIDER=openai    -> OpenAI, Groq, Azure OpenAI, OpenRouter, Ollama ... (set LLM_BASE_URL)
# LLM_PROVIDER=anthropic -> Claude via the Anthropic API
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# OpenAI-compatible only (default https://api.openai.com/v1). Groq: https://api.groq.com/openai/v1
LLM_BASE_URL=
# Comma separated models tried if the main one fails (OpenAI-compatible only)
LLM_FALLBACK_MODELS=
# Empty = provider default. Some models reject anything but their default temperature.
LLM_TEMPERATURE=0
# Claude only: low | medium | high (thinking depth and cost)
LLM_EFFORT=medium

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ids mapped to the middleware caller: "telegram_id:caller" pairs
TELEGRAM_USERS=
MIDDLEWARE_URL=http://127.0.0.1:8100
# API key (from API_KEYS) per caller for the bot to use: "caller:apikey" pairs
MIDDLEWARE_KEYS=
TELEGRAM_ALLOW_ALL=0
# Speech-to-text (OpenAI-compatible /audio/transcriptions: Groq or OpenAI)
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3
STT_LANGUAGE=
